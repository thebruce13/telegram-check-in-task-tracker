# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather
# Your personal numeric Telegram user/chat ID (see README "Finding your chat ID").
# Only messages from this ID will be accepted by the bot.
TELEGRAM_CHAT_ID=123456789

# --- Google Sheets ---
GOOGLE_SHEETS_CREDENTIALS_FILE=/app/credentials/service_account.json
GOOGLE_SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz-exampleSheetId
GOOGLE_WORKSHEET_NAME=Sheet1

# --- Behavior ---
# Interval between "are you still working on X?" prompts, in minutes.
CHECKIN_INTERVAL_MINUTES=30
# IANA timezone used for timestamps written to the sheet.
TZ=America/Chicago

# --- Internal ---
PERSISTENCE_PATH=/app/data/bot_persistence.pickle
